# 開発環境用のDockerfile
FROM golang:1.26-trixie

# 開発ツールのインストール
RUN apt update && apt install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# go.modとgo.sumをコピーして依存関係をダウンロード
COPY go.mod go.sum ./
RUN go mod download

# ソースコードをコピー
COPY . .

# ビルド（ホットリロード用）
RUN go build -o /calendar-api ./cmd/api

EXPOSE 8080

# 開発環境ではホットリロードを有効にするため、コマンドを変更可能にする
CMD ["/calendar-api"]
